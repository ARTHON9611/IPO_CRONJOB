# ---- Supabase (source of truth) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase (used by the sync scripts/cron)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# External IPO data provider key
IPO_ALERTS_API_KEY=your-ipoalerts-key

# ---- Upstash Redis (edge cache, shields Supabase from load) ----
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ---- Cloudflare Access (protects /admin/sync) ----
CF_ACCESS_CLIENT_ID=your-service-token-client-id
CF_ACCESS_CLIENT_SECRET=your-service-token-client-secret
ADMIN_SYNC_TOKEN=your-admin-bearer-token

# Stable public site URL (used by the homepage to fetch /api/ipos for ISR;
# avoids Vercel's gated per-deployment URL). Set to your production alias.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Edge-cache purge after sync (POSTed by /admin/sync to the Worker /__purge).
WORKER_PURGE_URL=https://your-worker.your-subdomain.workers.dev/__purge
WORKER_PURGE_TOKEN=your-purge-token
# Worker secret (set via: wrangler secret put PURGE_TOKEN)
# PURGE_TOKEN=<same-as-WORKER_PURGE_TOKEN>
